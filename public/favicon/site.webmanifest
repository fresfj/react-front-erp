{
  "name": "Cardápio Online & ERP",
  "short_name": "ERP & Delivery",
  "description": "Cardápio digital, delivery, pedidos em tempo real e gestão ERP/PDV.",
  "display": "standalone",
  "orientation": "portrait",
  "lang": "pt-BR",
  "scope": "/",
  "start_url": "/",
  "display_override": [
    "window-control-overlay",
    "minimal-ui"
  ],
  "icons": [
    {
      "src": "/favicon/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "theme_color": "#00A76F",
  "background_color": "#ffffff"
}
