{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "module": "esnext",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": false,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/**/*",
  ],
  "exclude": [
    "node_modules",
    "docs",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/auth/context/amplify",
    "src/auth/context/auth0",
    "src/auth/context/supabase",
    "src/lib/supabase.ts",
    "src/layouts/config-nav-main.tsx",
    "src/layouts/main",
    "src/sections/_examples",
    "src/sections/account",
    "src/sections/auth/amplify",
    "src/sections/auth/auth0",
    "src/sections/auth/supabase",
    "src/sections/blog",
    "src/sections/chat",
    "src/sections/checkout",
    "src/sections/home",
    "src/sections/invoice",
    "src/sections/job",
    "src/sections/mail",
    "src/sections/order",
    "src/sections/overview",
    "src/sections/product",
    "src/sections/tour",
    "src/sections/user",
    "src/pages/auth/amplify",
    "src/pages/auth/auth0",
    "src/pages/auth/supabase",
    "src/pages/about-us",
    "src/pages/auth-demo",
    "src/pages/blank",
    "src/pages/coming-soon",
    "src/pages/components",
    "src/pages/contact-us",
    "src/pages/dashboard/analytics",
    "src/pages/dashboard/banking",
    "src/pages/dashboard/blank",
    "src/pages/dashboard/booking",
    "src/pages/dashboard/calendar",
    "src/pages/dashboard/chat",
    "src/pages/dashboard/course",
    "src/pages/dashboard/ecommerce",
    "src/pages/dashboard/file",
    "src/pages/dashboard/file-manager",
    "src/pages/dashboard/invoice",
    "src/pages/dashboard/job",
    "src/pages/dashboard/kanban",
    "src/pages/dashboard/mail",
    "src/pages/dashboard/order",
    "src/pages/dashboard/params",
    "src/pages/dashboard/permission",
    "src/pages/dashboard/post",
    "src/pages/dashboard/product",
    "src/pages/dashboard/tour",
    "src/pages/dashboard/user",
    "src/pages/faqs",
    "src/pages/home.tsx",
    "src/pages/maintenance",
    "src/pages/payment",
    "src/pages/post",
    "src/pages/pricing",
    "src/pages/product"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
