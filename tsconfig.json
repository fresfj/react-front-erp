{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "module": "esnext",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": false,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "docs",
    "src/auth/context/amplify",
    "src/auth/context/auth0",
    "src/auth/context/supabase",
    "src/lib/supabase.ts",
    "src/layouts/config-nav-main.tsx",
    "src/layouts/main",
    "src/sections/_examples",
    "src/sections/auth/amplify",
    "src/sections/auth/auth0",
    "src/sections/auth/supabase",
    "src/sections/checkout",
    "src/sections/home",
    "src/pages/auth/amplify",
    "src/pages/auth/auth0",
    "src/pages/auth/supabase",
    "src/pages/about-us",
    "src/pages/auth-demo",
    "src/pages/blank",
    "src/pages/coming-soon",
    "src/pages/components",
    "src/pages/contact-us",
    "src/pages/faqs",
    "src/pages/home.tsx",
    "src/pages/maintenance",
    "src/pages/payment",
    "src/pages/post",
    "src/pages/pricing",
    "src/pages/product"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
