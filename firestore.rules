rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roleOk() {
      return request.auth.token.role in ['admin', 'gestor', 'operador'];
    }
    function sameEnterprise(enterpriseId) {
      return request.auth.token.enterpriseId == enterpriseId;
    }
    function isAdminOrGestor() {
      return request.auth.token.role in ['admin', 'gestor'];
    }
    function isPlatformAdmin() {
      return request.auth.token.platformAdmin == true;
    }
    function isTenantAdmin() {
      return request.auth.token.role == 'admin';
    }

    function memberDoc(enterpriseId) {
      return get(/databases/$(database)/documents/enterprises/$(enterpriseId)/members/$(request.auth.uid));
    }

    function hasDefaultOperatorPerm(key) {
      return key in ['pos', 'customers', 'cash_close', 'batches_read'];
    }

    function memberHasExplicitPerm(enterpriseId, key) {
      return memberDoc(enterpriseId).data.keys().hasAny(['permissions'])
        && memberDoc(enterpriseId).data.permissions is list
        && key in memberDoc(enterpriseId).data.permissions;
    }

    function memberUsesDefaultPerms(enterpriseId) {
      return !memberDoc(enterpriseId).data.keys().hasAny(['permissions'])
        || memberDoc(enterpriseId).data.permissions == null
        || !(memberDoc(enterpriseId).data.permissions is list)
        || memberDoc(enterpriseId).data.permissions.size() == 0;
    }

    function hasPerm(enterpriseId, key) {
      return signedIn() && (
        isPlatformAdmin()
        || (sameEnterprise(enterpriseId) && isAdminOrGestor())
        || (
          sameEnterprise(enterpriseId)
          && roleOk()
          && (
            memberHasExplicitPerm(enterpriseId, key)
            || (memberUsesDefaultPerms(enterpriseId) && hasDefaultOperatorPerm(key))
          )
        )
      );
    }

    function isValidWaiterTableOrder(data) {
      return data.orderSource == 'waiter'
        && data.deliveryType == 'table'
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 100
        && data.subtotal is number
        && data.subtotal >= 0
        && data.total is number
        && data.total >= 0
        && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 120))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('internalNotes' in data) || (data.internalNotes is string && data.internalNotes.size() <= 500));
    }

    // Assumed Data Model: enterprises/{enterpriseId}/bankReconciliations/{entryId}
    // Required: fitid (string <=160), date (YYYY-MM-DD), amount (number != 0),
    //           memo (string <=500), status ('pending'|'reconciled'|'ignored'), createdAt (string <=64)
    // Optional: bankName (<=120), matchedLedgerId (<=128), matchedLedgerReason (<=300),
    //           reconciledAt (<=64), reconciledBy (<=128)
    // Immutable after create: fitid, date, amount, memo, bankName, createdAt
    function isValidBankReconciliationEntry(data) {
      return data.keys().hasOnly([
          'fitid',
          'date',
          'amount',
          'memo',
          'bankName',
          'status',
          'matchedLedgerId',
          'matchedLedgerReason',
          'reconciledAt',
          'reconciledBy',
          'createdAt'
        ])
        && data.keys().hasAll(['fitid', 'date', 'amount', 'memo', 'status', 'createdAt'])
        && data.fitid is string
        && data.fitid.size() > 0
        && data.fitid.size() <= 160
        && data.date is string
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.amount is number
        && data.amount != 0
        && data.memo is string
        && data.memo.size() <= 500
        && data.status in ['pending', 'reconciled', 'ignored']
        && data.createdAt is string
        && data.createdAt.size() > 0
        && data.createdAt.size() <= 64
        && (!('bankName' in data) || (data.bankName is string && data.bankName.size() <= 120))
        && (!('matchedLedgerId' in data) || (data.matchedLedgerId is string && data.matchedLedgerId.size() <= 128))
        && (!('matchedLedgerReason' in data) || (data.matchedLedgerReason is string && data.matchedLedgerReason.size() <= 300))
        && (!('reconciledAt' in data) || (data.reconciledAt is string && data.reconciledAt.size() <= 64))
        && (!('reconciledBy' in data) || (data.reconciledBy is string && data.reconciledBy.size() <= 128));
    }

    match /enterprises/{enterpriseId} {
      allow read: if signedIn() && (
        isPlatformAdmin() || (sameEnterprise(enterpriseId) && roleOk())
      );
      allow create, delete: if signedIn() && isPlatformAdmin();
      // platformAdmin may update; tenant admin/gestor may update but never subscription (CF-only)
      allow update: if signedIn() && (
        isPlatformAdmin()
        || (
          sameEnterprise(enterpriseId)
          && isAdminOrGestor()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription'])
        )
      );
    }

    match /enterprises/{enterpriseId}/subscriptionInvoices/{invoiceId} {
      allow read: if signedIn() && (
        isPlatformAdmin() || (sameEnterprise(enterpriseId) && isTenantAdmin())
      );
      allow write: if false;
    }

    match /plans/{planId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /platformSettings/{docId} {
      allow read: if signedIn() && isPlatformAdmin();
      allow write: if false;
    }

    match /platformSecrets/{docId} {
      allow read, write: if false;
    }

    match /enterprises/{enterpriseId}/products/{id} {
      // PDV (pos) e Garçom/Mesas (tables) precisam ler o catálogo para vender/lançar pedidos; escrita só com 'products'
      allow read: if hasPerm(enterpriseId, 'products')
        || hasPerm(enterpriseId, 'pos')
        || hasPerm(enterpriseId, 'tables');
      allow write: if hasPerm(enterpriseId, 'products');
    }

    match /enterprises/{enterpriseId}/suppliers/{id} {
      allow read, write: if hasPerm(enterpriseId, 'suppliers');
    }

    match /enterprises/{enterpriseId}/customers/{id} {
      allow read: if hasPerm(enterpriseId, 'customers');
      // OR: PDV credit_tab + AR/AP debt sync (spec §8.1)
      allow write: if hasPerm(enterpriseId, 'customers')
        || hasPerm(enterpriseId, 'pos')
        || hasPerm(enterpriseId, 'dre');
    }

    match /enterprises/{enterpriseId}/sales/{id} {
      allow read: if hasPerm(enterpriseId, 'pos');
      allow create: if hasPerm(enterpriseId, 'pos') || hasPerm(enterpriseId, 'tables');
      allow update, delete: if hasPerm(enterpriseId, 'pos');
    }

    match /enterprises/{enterpriseId}/onlineOrders/{id} {
      allow read: if hasPerm(enterpriseId, 'pos') || hasPerm(enterpriseId, 'tables');
      allow create: if (hasPerm(enterpriseId, 'tables') || hasPerm(enterpriseId, 'pos'))
        && isValidWaiterTableOrder(request.resource.data);
      allow update: if hasPerm(enterpriseId, 'pos') || hasPerm(enterpriseId, 'tables');
      allow delete: if hasPerm(enterpriseId, 'pos');
    }

    match /enterprises/{enterpriseId}/tables/{id} {
      allow read: if hasPerm(enterpriseId, 'tables') || hasPerm(enterpriseId, 'pos');
      allow write: if hasPerm(enterpriseId, 'tables') || hasPerm(enterpriseId, 'pos');
    }

    match /enterprises/{enterpriseId}/tableSessions/{id} {
      allow read: if hasPerm(enterpriseId, 'tables') || hasPerm(enterpriseId, 'pos');
      allow write: if hasPerm(enterpriseId, 'tables') || hasPerm(enterpriseId, 'pos');
    }

    match /publicStoreIndex/{slug} {
      allow read, write: if false; // Cloud Functions / Admin SDK only
    }

    match /enterprises/{enterpriseId}/cashSessions/{id} {
      // OR: settlement from payables/receivables (spec §8.1) + waiter read open session
      allow read: if hasPerm(enterpriseId, 'cash_close')
        || hasPerm(enterpriseId, 'dre')
        || hasPerm(enterpriseId, 'tables');
      allow write: if hasPerm(enterpriseId, 'cash_close')
        || hasPerm(enterpriseId, 'dre');
    }

    match /enterprises/{enterpriseId}/payables/{id} {
      allow read, write: if hasPerm(enterpriseId, 'dre');
    }

    match /enterprises/{enterpriseId}/receivables/{id} {
      allow read, write: if hasPerm(enterpriseId, 'dre');
    }

    match /enterprises/{enterpriseId}/bankReconciliations/{entryId} {
      allow read: if hasPerm(enterpriseId, 'cash_close')
        || hasPerm(enterpriseId, 'dre');
      allow create: if (hasPerm(enterpriseId, 'cash_close') || hasPerm(enterpriseId, 'dre'))
        && isValidBankReconciliationEntry(request.resource.data)
        && request.resource.data.status == 'pending';
      allow update: if (hasPerm(enterpriseId, 'cash_close') || hasPerm(enterpriseId, 'dre'))
        && isValidBankReconciliationEntry(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'fitid',
          'date',
          'amount',
          'memo',
          'bankName',
          'createdAt'
        ]);
      allow delete: if hasPerm(enterpriseId, 'cash_close')
        || hasPerm(enterpriseId, 'dre');
    }

    match /enterprises/{enterpriseId}/processingOrders/{id} {
      allow read, write: if hasPerm(enterpriseId, 'processing');
    }

    match /enterprises/{enterpriseId}/batches/{id} {
      allow read: if hasPerm(enterpriseId, 'batches_read');
      // OR: FIFO deduction during POS sale (spec §8.1)
      allow write: if hasPerm(enterpriseId, 'batches_write')
        || hasPerm(enterpriseId, 'pos');
    }

    match /enterprises/{enterpriseId}/stockMovements/{id} {
      allow read: if hasPerm(enterpriseId, 'batches_read');
      allow write: if hasPerm(enterpriseId, 'batches_write')
        || hasPerm(enterpriseId, 'pos');
    }

    match /enterprises/{enterpriseId}/members/{uid} {
      allow read: if signedIn() && (
        isPlatformAdmin() || (sameEnterprise(enterpriseId) && roleOk())
      );
      allow write: if signedIn() && (
        isPlatformAdmin()
        || (sameEnterprise(enterpriseId) && (isAdminOrGestor() || request.auth.uid == uid))
      );
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
